PROJECT_NAME="E-Commerce Payment Platform"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# SQLAlchemy Database URL (Generated in config.py dynamically, or hardcoded here)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ecommerce_db

# Security (Change SECRET_KEY in production!)
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe Configuration (Leave empty or set dummy values to run in Mock Mode)
STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

