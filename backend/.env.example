PROJECT_NAME="E-Commerce Payment Platform"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# SQLAlchemy Database URL (Generated in config.py dynamically, or hardcoded here)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_db

# Security (Change SECRET_KEY in production!)
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

